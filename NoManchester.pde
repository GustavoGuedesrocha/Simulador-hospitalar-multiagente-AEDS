class NoManchester {

  boolean folha;
  int indiceAtributo;
  String operador;
  float valorComparacao;
  String cor;

  NoManchester(boolean folha, int indiceAtributo, String operador, float valorComparacao, String cor) {
    this.folha = folha;
    this.indiceAtributo = indiceAtributo;
    this.operador = operador;
    this.valorComparacao = valorComparacao;
    this.cor = cor;
  }
}